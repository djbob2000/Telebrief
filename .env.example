# Telegram User API (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# OpenRouter API (Primary recommended provider)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI API Key (required when ai_provider is "openai")
# OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# Anthropic API Key (required when ai_provider is "anthropic")
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (required when ai_provider is "google")
# GEMINI_API_KEY=...
# Optional backup Gemini keys (Round-Robin with Cooldown failover)
# GEMINI_API_KEY_2=...
# GEMINI_API_KEY_3=...
# GEMINI_API_KEY_4=...
# GEMINI_API_KEY_5=...

# Optional global model override (overrides settings.ai_model in config.yaml)
# AI_MODEL=minimax/minimax-m3:free

# Logging
LOG_LEVEL=INFO

# PostgreSQL domain persistence (multisource foundation).
# Migration phase default: disabled. Required only when config.yaml sets
# database.enabled: true. Telebrief never logs this value.
# DATABASE_URL=postgresql://telebrief:password@localhost:5432/telebrief

# Database Backups & Mega Cloud Storage
# MEGA_USER=your_email@example.com
# MEGA_PASSWORD=your_mega_password
# MEGA_BACKUP_DIR=telebrief-backups
# BACKUP_RETENTION_DAYS=14
# BACKUP_ALERT_CHAT_ID=123456789
