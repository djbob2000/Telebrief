# Telegram User API (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# OpenAI API Key (required when ai_provider is "openai")
OPENAI_API_KEY=sk-proj-...

# Optional OpenAI-compatible endpoint (DeepSeek example)
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# Anthropic API Key (required when ai_provider is "anthropic")
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (required when ai_provider is "google")
# GEMINI_API_KEY=...
# Optional backup Gemini keys (Round-Robin with Cooldown failover)
# GEMINI_API_KEY_2=...
# GEMINI_API_KEY_3=...
# GEMINI_API_KEY_4=...
# GEMINI_API_KEY_5=...

# Optional final fallback through OpenRouter
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Logging
LOG_LEVEL=INFO
