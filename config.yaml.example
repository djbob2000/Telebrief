# Telegram channels/chats to monitor
channels:
  - id: "@channelname"
    name: "Example Channel"
    # source_type: mixed # news|community|official|classifieds|mixed; editorial role, not trust
    # group: Jobs              # optional — bind to a digest_groups entry (or "Other")
    # prompt_extra: ""         # optional — append extra instructions to this channel's AI prompt
    # lookback_hours: null     # optional — override global lookback_hours for this channel
    # filters: null            # optional — null=use global filters, []=no filters, list=override
    # topics:                  # optional — for Telegram forum groups, collect only these topics
    #   - id: 12345
    #     name: "Selected topic"
    #     source_type: news # optional topic override
  # Add your channels here
  # Format for public channels: "@channelname" (string with quotes)
  # Format for private channels/groups: -1001234567890 (integer, NO quotes!)
  #
  # IMPORTANT: Get the correct channel ID using @RawDataBot
  # - Forward a message from the channel to @RawDataBot
  # - Copy the complete chat ID (should start with -100)
  #
  # ✅ Correct:   id: -1001234567890  (integer with -100 prefix, no quotes)
  # ❌ Wrong:     id: "-1001234567890" (has quotes)
  # ❌ Wrong:     id: -1234567890     (missing -100 prefix)

# Telegram operational settings
# processing_mode: "knowledge_full" (default with vector embeddings) or "knowledge_no_embeddings" (lexical/time/place clustering without external embeddings)
# telegram:
#   processing_mode: "knowledge_full"

# Application settings
settings:
  # Scheduling
  schedule_time: "09:00"   # One daily digest
  timezone: "UTC"
  lookback_hours: 24       # Global collection window

  # AI Provider: "openai", "ollama", "anthropic", "google", or "openrouter"
  # Required env vars per provider:
  # AI Provider:
  #   openrouter -> OPENROUTER_API_KEY in .env (Primary recommended)
  #   openai     -> OPENAI_API_KEY in .env
  #   anthropic  -> ANTHROPIC_API_KEY in .env
  #   google     -> GEMINI_API_KEY (+ optional _2/_3 backups) in .env
  #   ollama     -> no API key needed
  ai_provider: "openrouter"

  # AI Model (provider-specific, can be overridden by OPENROUTER_MODEL or AI_MODEL in .env)
  # OpenRouter: "minimax/minimax-m3:free", "deepseek/deepseek-chat", etc.
  # OpenAI: "gpt-5-nano", "gpt-4o-mini", etc.
  # Ollama: "llama3", "mistral", "gemma2", etc.
  # Anthropic: "claude-sonnet-4-5-20250929", etc.
  # Google: "gemini-3.6-flash"
  ai_model: "minimax/minimax-m3:free"

  # Legacy OpenAI settings (used as fallback if ai_model not set)
  openai_model: "gpt-5-nano"
  openai_temperature: 1.0
  max_tokens_per_summary: 96000

  # Ollama settings (only used when ai_provider is "ollama")
  ollama_base_url: "http://localhost:11434"

  # Digest mode: "channel" (default) groups by channel, "digest" groups by topic
  digest_mode: "channel"
  # Deduplicate cross-channel topics: when true, the AI keeps only the most informative
  # bullet point when multiple channels cover the same event (sources are merged).
  # Only effective in digest_mode: "digest".
  # dedup_topics: false
  # Topic groups for digest mode (only used when digest_mode is "digest")
  # An implicit "Other" group catches anything that doesn't match defined groups.
  # digest_groups:
  #   - name: "Events"
  #     description: "Conferences, meetups, releases, launches, announcements"
  #     prompt_extra: ""       # optional — append extra instructions to all channels in this group
  #   - name: "News"
  #     description: "Politics, economy, world affairs, breaking news"
  #   - name: "Sport"
  #     description: "Sports results, transfers, tournaments, matches"

  # Filter chain — drop messages before they reach storage and the AI
  # Runs after collection; filtered messages are never stored or summarized.
  # Built-in filters: KeywordFilter, RegexFilter, MinLengthFilter
  # filters:
  #   - class_path: src.extensions.filters.KeywordFilter
  #     config:
  #       include: ["job", "hiring", "remote"]
  #       exclude: ["nsfw"]
  #   - class_path: src.extensions.filters.MinLengthFilter
  #     config:
  #       min_chars: 30

  # Persistent ingestion cutover (transitional migration flag, default false).
  # When true, digests and articles read their inputs from the PostgreSQL
  # source history populated by the ingestion worker and never touch Telethon;
  # database failures surface as explicit errors (no live-Telegram fallback).
  # The configured filter chain still runs after the DB read. Requires
  # database.enabled: true (see the database: block below).
  # persistent_ingestion: false

  # Event-First Pipeline Settings (cost-bounded event clustering and coalesced analysis)
  # event_pipeline:
  #   mode: "legacy_claims"  # "legacy_claims" | "event_first_shadow" | "event_first"
  #   fragment_max_chars: 1200
  #   active_window_hours: 72
  #   join_similarity: 0.84
  #   max_cluster_candidates: 20
  #   embedding_batch_size: 128
  #   direct_analysis_min_fragments: 3
  #   direct_analysis_min_unique_sources: 2
  #   triage_batch_size: 80
  #   triage_excerpt_chars: 320
  #   triage_min_ignore_confidence: 0.95
  #   analysis_quiet_seconds: 120
  #   analysis_min_interval_seconds: 600
  #   analysis_min_new_fragments: 3
  #   analysis_max_calls_per_story_per_hour: 4
  #   provider_retry_backoff_seconds: 300
  #   analysis_max_input_chars: 24000
  #   representative_fragment_limit: 16
  #   rich_analysis_max_calls_per_cycle: 40
  #   live_batch_size: 100
  #   backfill_batch_size: 500


  # Output
  output_language: "Russian"  # Language for AI summaries (e.g., "English", "Russian", "Spanish")
  use_emojis: true
  include_statistics: true

  # Telegram Bot
  target_user_id: 0  # Your Telegram user ID (get from @userinfobot)
  target_chat_id: ""  # Destination chat/channel; defaults to target_user_id
  auto_cleanup_old_digests: true  # Automatically delete previous digest messages

  # Safety limits
  max_messages_per_channel: 5000
  max_prompt_chars: 8000  # Max characters of message content fed to AI per channel.
                          # Keeps the most recent messages that fit. Increase for models with
                          # large context windows; decrease if you hit "empty content + finish_reason=length".
                          #
                          # How to calculate:
                          #   1. Find your model's context window (total tokens for input + output):
                          #      - OpenAI:    https://platform.openai.com/docs/models
                          #      - Anthropic: https://docs.anthropic.com/en/docs/about-claude/models
                          #      - Ollama:    check model card on https://ollama.com/library
                          #   2. Subtract max output tokens (e.g. max_tokens_per_summary * 2 as buffer)
                          #   3. Subtract ~2000 tokens for system prompt and formatting
                          #   4. Multiply remaining tokens by chars-per-token ratio:
                          #      - English text:          ~4 chars/token
                          #      - Russian/Cyrillic text: ~2-3 chars/token
                          #      - Mixed/CJK text:       ~1.5-2 chars/token
                          #
                          # Example for gpt-4o-mini (128K context, 16K max output):
                          #   (128000 - 16000 - 2000) * 2.5 = 275,000 chars (aggressive)
                          #   Safe recommendation: 50000 (conservative for Russian content)
                          #
                          # Example for claude-sonnet (200K context, 8K max output):
                          #   (200000 - 8000 - 2000) * 2.5 = 475,000 chars (aggressive)
                          #   Safe recommendation: 100000
                          #
                          # Example for ollama llama3-8b (8K context, 2K max output):
                          #   (8000 - 2000 - 2000) * 2.5 = 10,000 chars
                          #   Safe recommendation: 8000
  api_timeout: 30  # Ollama may need 120-300s for local models (enforced minimum: 120s)

  # Evening editorial article (Telegra.ph Instant View)
  article:
    enabled: true
    schedule_time: "20:00"
    lookback_hours: 24
    author_name: "Бердянск Новости"
    fallback_save_dir: "data/articles"
    # save_debug_artifacts: false  # opt-in; contains source messages and stays local
    # debug_artifact_dir: "data/debug/editorial"
    # generation_retries: 2  # (Deprecated) Adaptive recovery state machine is used instead.
    # generation_retry_delay: 1.0  # (Deprecated) Retained for schema backwards-compatibility.
    # telegraph_access_token: ""  # Optional: generated automatically if omitted


# Prompt customization — top-level block (sibling of settings:, not nested inside it)
# base_template: path to the system prompt template file ({language} is substituted at runtime)
# composer: dotted path to a custom PromptComposer class; empty = built-in DefaultComposer
# prompts:
#   base_template: src/prompts/base_summary.txt
#   composer: ""

# Storage — persist raw messages for history / external LLM workflows
# Note: storage is append-only; overlapping lookback windows produce duplicate rows.
# storage:
#   enabled: false
#   backend: sqlite          # "sqlite" (default, no extra setup) or "postgres"
#   path: data/messages.db   # sqlite only — relative to project root; mount as volume in Docker
#   url: ""                  # postgres: postgresql://user:pass@host:5432/db

# Domain database (PostgreSQL) — powers the new domain persistence layer and the
# Procrastinate background job queue. Migration phase default: disabled; the legacy
# SQLite storage keeps working untouched while this is off. The connection URL is read
# from the DATABASE_URL environment variable (.env), never from this file, and is
# never logged. Bounds: 1 <= min_pool_size <= max_pool_size <= 10.
# database:
#   enabled: false              # set true once DATABASE_URL is provisioned
#   min_pool_size: 1
#   max_pool_size: 3
#   domain_schema: "public"
#   procrastinate_schema: "procrastinate"

# Generic ingestion collection — polling cadence for bootstrap-managed Telegram
# sources in the domain database (independent of the daily digest schedule).
# The value is mirrored into each managed source's collector_options
# (schedule.interval_minutes) at bootstrap time. Must be an integer between
# 5 and 360 minutes; defaults to 45 when this block is absent.
# collection:
#   telegram_interval_minutes: 45

# Semantic embeddings (knowledge pipeline) — one whole-object vector per claim
# and per story revision, stored immutably in pgvector. model + dimensions
# name ONE vector space: they are frozen into every embedding job, and changing
# them schedules a new backfill instead of touching old rows.
# dimensions must satisfy 128 <= dimensions <= 3072. The API key is the shared
# GEMINI_API_KEY (.env) — never stored or logged via this file.
# embedding:
#   provider: "google"
#   model: "gemini-embedding-2"
#   dimensions: 1536
#   timeout: 45

# MCP server — expose digests to MCP clients (Claude Code, etc.) over HTTP
# Runs inside the Telebrief process; tools: get_digest(hours), get_last_digest()
# Connect with: claude mcp add --transport http telebrief http://127.0.0.1:8765/mcp
# WARNING: there is no authentication. Keep host on loopback, or firewall the port.
# In Docker, publish it as "127.0.0.1:8765:8765" rather than binding 0.0.0.0 openly.
# mcp:
#   enabled: false
#   host: "127.0.0.1"
#   port: 8765
#   path: "/mcp"

# Facebook provider — public group/page ingestion via authenticated browser session
# Persistent browser profile storage is maintained under auth_root (directory permission 700).
# Auth profiles must be initialized manually using `python scripts/bootstrap_facebook_profile.py --profile profile-01`.
# facebook:
#   enabled: false
#   editorial_enabled: true
#   auth_root: "/var/lib/telebrief/auth"
#   auth_profiles:
#     - name: "profile-01"
#       storage_ref: "profile-01"
#   sources:
#     - url: "https://www.facebook.com/groups/berdyansk.news"
#       name: "Бердянск Новости FB"
#       auth_profile: "profile-01"
#       scan_times:
#         - "08:00"
#         - "14:00"
#         - "20:00"
#       timezone: "Europe/Kyiv"
#   comments:
#     include_replies: true
#     max_comments_per_post: 500
#     max_replies_per_comment: 100
#     max_pages_per_refresh: 20
#     max_duration_per_post_seconds: 120
